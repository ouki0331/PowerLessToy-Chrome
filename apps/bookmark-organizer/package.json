{
  "name": "@powerless-toy/bookmark-organizer",
  "version": "0.4.1",
  "private": true,
  "description": "Chrome extension for organizing project links and environment portals on Chrome new tab",
  "type": "module",
  "scripts": {
    "test": "node --test tests/*.test.js",
    "build": "node scripts/build-extension.js",
    "build:chrome": "node scripts/build-extension.js --target=chrome",
    "build:firefox": "node scripts/build-extension.js --target=firefox",
    "dictionary:fetch": "node scripts/fetch-dictionary-data.js",
    "dictionary:test-fetch": "node scripts/test-fetch-integration.js",
    "dictionary:build": "node scripts/build-dictionary-packs.js",
    "dictionary:verify": "node scripts/verify-dictionary-packs.js",
    "dictionary:integration": "npm run dictionary:fetch && npm run dictionary:build && npm run dictionary:verify"
  },
  "devDependencies": {
    "fake-indexeddb": "^6.2.6",
    "web-ext": "^10.8.0"
  }
}
