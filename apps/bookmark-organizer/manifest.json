{
  "manifest_version": 3,
  "name": "PowerLessToy Bookmark Organizer",
  "version": "0.3.1",
  "description": "Organize and access project environments and everyday links on Chrome new tab.",
  "chrome_url_overrides": {
    "newtab": "src/newtab/index.html"
  },
  "action": {
    "default_icon": {
      "16": "assets/icons/icon-16.png",
      "48": "assets/icons/icon-48.png",
      "128": "assets/icons/icon-128.png"
    }
  },
  "options_ui": {
    "page": "src/options/index.html",
    "open_in_tab": false
  },
  "background": {
    "service_worker": "src/background/index.js",
    "type": "module",
    "scripts": ["src/background/index.js"]
  },
  "commands": {
    "open-bookmark-search": {
      "suggested_key": {
        "default": "Ctrl+Shift+K",
        "mac": "Command+Shift+K"
      },
      "description": "Open centralized bookmark search"
    }
  },
  "permissions": [
    "storage",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://commons.wikimedia.org/*",
    "https://upload.wikimedia.org/*"
  ],
  "browser_specific_settings": {
    "gecko": {
      "id": "bookmark-organizer@powerless-toy.local",
      "strict_min_version": "142.0",
      "data_collection_permissions": {
        "required": [
          "none"
        ]
      }
    }
  },
  "icons": {
    "16": "assets/icons/icon-16.png",
    "48": "assets/icons/icon-48.png",
    "128": "assets/icons/icon-128.png"
  }
}
